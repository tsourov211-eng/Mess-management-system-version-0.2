# ==========================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ==========================================
# Your MongoDB connection string
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ourmess?appName=Cluster0"

# ==========================================
# NEXTAUTH CONFIGURATION (Authentication)
# ==========================================
# On Vercel, set this to your live domain, e.g. https://your-project.vercel.app
NEXTAUTH_URL="https://your-project.vercel.app"

# A secure random secret string for JWT and session encryption
NEXTAUTH_SECRET="your-super-secret-key-here"

# ==========================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
