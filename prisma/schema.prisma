datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NEXT-AUTH DEFAULT MODELS ───
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MESS MANAGEMENT MODELS ───

// 1. User table
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("member")
  
  // 💡 Newly added field
  password      String?   
  resetToken    String?
  resetTokenExpiry DateTime?
  messName      String?   @default("Amader Mess")
  phone         String?   
  address       String?   

  // User's default meal setting
  defaultBreakfast Float @default(0.5)
  defaultLunch     Float @default(1.0)
  defaultDinner    Float @default(1.0)

  clearedNotices   String[] @db.ObjectId
  createdAt        DateTime? @default(now())
  updatedAt        DateTime? @updatedAt

  accounts      Account[]
  sessions      Session[]

  // Relationships
  meals         MealLog[]
  deposits      Deposit[]
  expenses      Expense[]
  bazaarDates   BazaarSchedule[]
  guestMeals    GuestMealRequest[]
}

// 2. Table for saving daily meals
model MealLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  breakfast Float    @default(0.0)
  lunch     Float    @default(0.0)
  dinner    Float    @default(0.0)
  guest     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date]) // One log per user per day
}

// 3. User deposited money table (Deposit)
model Deposit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  amount    Float
  method    String   @default("Cash")    
  note      String?                      
  status    String   @default("Pending") 
  date      DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 4. Mess expense table (Expense / Bazar)
model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId        
  amount      Float
  description String?                      
  status      String   @default("Pending") 
  date        DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) 
}

// 5. Bazar request date
model BazaarSchedule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  status    String   @default("pending") 
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 6. Notice board table
model Notice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  type        String   @default("info") 
  isActive    Boolean  @default(true) 
  createdAt   DateTime @default(now())
}

// 7. Guest meal request table
model GuestMealRequest {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  date        DateTime
  mealType    String    @default("LUNCH") 
  guests      Int       @default(1)
  status      String    @default("Pending") // Pending | Approved | Rejected
  reviewedBy  String?
  reviewedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 8. Monthly expense configuration table
model MonthlyExpense {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  month          String   @unique
  seatRent       Float    @default(0)
  electricityGas Float    @default(0)
  internet       Float    @default(0)
  maid           Float    @default(0)
  additional     Float    @default(0)
  mealCharge     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}